# Utilisé par Docker Compose. Pour le lanceur local, voir scripts/serve.py --help.
# Une adresse privée précise permet les tests LAN. Jamais 0.0.0.0 dans cette phase.
BIND_HOST=127.0.0.1
PORT=11435
# local : Ollama existant ; demo : simulé ; cloud : accès direct avec clé dédiée.
HONEYPOT_MODE=local
MAX_OUTPUT_TOKENS=2048
# 0 = illimité pour le quota correspondant.
MAX_REQUESTS_PER_DAY=30
MAX_REQUESTS_TOTAL=100
MAX_CONCURRENT=2
REQUEST_TIMEOUT_SECONDS=120
